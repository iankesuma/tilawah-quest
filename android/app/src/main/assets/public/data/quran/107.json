{"n":107,"name":"Al-Ma'un","ar":"المَاعُونِ","ayat":7,"ayahs":[{"i":1,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","tr":"Tahukah kamu (orang) yang mendustakan agama?"},{"i":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","tr":"Itulah orang yang menghardik anak yatim,"},{"i":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","tr":"dan tidak menganjurkan memberi makan orang miskin."},{"i":4,"ar":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","tr":"Maka kecelakaanlah bagi orang-orang yang shalat,"},{"i":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","tr":"(yaitu) orang-orang yang lalai dari shalatnya,"},{"i":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","tr":"orang-orang yang berbuat riya,"},{"i":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tr":"dan enggan (menolong dengan) barang berguna."}]}